<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=e8fecb0beda7148afa390dcdd8f4db62&amp;type=3#MainMenuStyle" />
    <ui:VisualElement style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.95); flex-shrink: 0;">
        <ui:VisualElement name="logoContainer" style="flex-grow: 3;">
            <ui:VisualElement name="logo" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/UI/PauseMenu/Menu%20Sprites/UI_Main_Menu_abs_v01_Title_lay01.png?fileID=2800000&amp;guid=a938a40db018b44b2ab49ed7078ca01a&amp;type=3#UI_Main_Menu_abs_v01_Title_lay01&quot;); width: 486px; height: 304px; -unity-text-align: upper-left; align-items: stretch; align-self: center; opacity: 1; flex-shrink: 0; min-width: 486px; min-height: 304px; margin-top: 239px;" />
        </ui:VisualElement>
        <ui:VisualElement name="buttons" style="flex-grow: 1;">
            <ui:Button name="start" enable-rich-text="true" style="background-color: rgba(188, 188, 188, 0);" />
        </ui:VisualElement>
        <ui:VisualElement name="Buttons" style="flex-grow: 1; justify-content: flex-end; margin-bottom: 77px; display: flex; visibility: visible; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;">
            <ui:Button name="Start" enabled="true" class="button startButton" style="background-image: url(&quot;project://database/Assets/UI/PauseMenu/Menu%20Sprites/UI_Main_Menu_abs_v02_Start_Button_lay01.png?fileID=2800000&amp;guid=604767b36116a4ecba92c012a80a6799&amp;type=3#UI_Main_Menu_abs_v02_Start_Button_lay01&quot;); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
            <ui:Button name="Resume" class="button" style="background-image: url(&quot;project://database/Assets/UI/PauseMenu/Menu%20Sprites/UI_Main_Menu_abs_v02_Fortsetzen_Button_lay01.png?fileID=2800000&amp;guid=57f26e8c1684740a784d6b87eb4bf0b8&amp;type=3#UI_Main_Menu_abs_v02_Fortsetzen_Button_lay01&quot;);" />
            <ui:Button name="Exit" class="button" style="background-image: url(&quot;project://database/Assets/UI/PauseMenu/Menu%20Sprites/UI_Main_Menu_abs_v02_Beenden_Button_lay01.png?fileID=2800000&amp;guid=1218737e98b104a699e89a673ed0b0b0&amp;type=3#UI_Main_Menu_abs_v02_Beenden_Button_lay01&quot;);" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
