<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=e8fecb0beda7148afa390dcdd8f4db62&amp;type=3#MainMenuStyle" />
    <ui:VisualElement style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.88); flex-shrink: 0;">
        <ui:VisualElement name="logoContainer" style="flex-grow: 3;">
            <ui:VisualElement name="logo" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/UI/PauseMenu/Menu%20Sprites/UI_Main_Menu_abs_v01_Title_lay01.png?fileID=2800000&amp;guid=a938a40db018b44b2ab49ed7078ca01a&amp;type=3#UI_Main_Menu_abs_v01_Title_lay01&quot;); width: 486px; height: 304px; -unity-text-align: upper-left; align-items: stretch; align-self: center; opacity: 1; flex-shrink: 0; min-width: 486px; min-height: 304px; margin-top: 239px;" />
        </ui:VisualElement>
        <ui:VisualElement name="Buttons" style="flex-grow: 1; justify-content: flex-end; margin-bottom: 77px;">
            <ui:Button name="Start" class="button" />
            <ui:Button name="Resume" class="button" style="background-image: url(&quot;project://database/Assets/UI/PauseMenu/Menu%20Sprites/UI_Main_Menu_abs_v01_Fortsetzen_Button_lay01.png?fileID=2800000&amp;guid=f15d8ce9e15d249ca997f114d5347cab&amp;type=3#UI_Main_Menu_abs_v01_Fortsetzen_Button_lay01&quot;);" />
            <ui:Button name="Exit" class="button" style="background-image: url(&quot;project://database/Assets/UI/PauseMenu/Menu%20Sprites/UI_Main_Menu_abs_v01_Beenden_Button_lay01.png?fileID=2800000&amp;guid=5e6ec25ebb06c412d9f4ae6453c6ed51&amp;type=3#UI_Main_Menu_abs_v01_Beenden_Button_lay01&quot;);" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
