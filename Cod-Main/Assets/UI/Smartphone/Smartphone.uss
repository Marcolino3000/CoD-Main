/* Smartphone — dark-mode tokens and shared classes.
   Icons are intentionally untinted; PNG sources provide the colour. */

/* ---------- Phone screen ---------- */
.phone-screen {
    background-color: rgb(0, 0, 0);
    -unity-font-definition: url("project://database/Assets/Fonts/Fancy-Regular.otf?fileID=12800000&guid=37567676b964d4408b499bb1e061114a&type=3#Fancy-Regular");
}

/* ---------- Status bar ---------- */
.status-bar {
    flex-direction: row;
    align-items: center;
    height: 40px;
    padding-left: 12px;
    padding-right: 12px;
    flex-shrink: 0;
}

.status-bar__group {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
}

.status-bar__group--right {
    justify-content: flex-end;
}

.status-bar__text {
    font-size: 18px;
    color: rgb(245, 245, 247);
    -unity-font-style: bold;
}

.status-bar__time {
    flex-grow: 1;
    flex-basis: 0;
    font-size: 24px;
    color: rgb(245, 245, 247);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}

/* ---------- Headline / search ---------- */
.headline {
    font-size: 36px;
    color: rgb(245, 245, 247);
    -unity-font-style: bold;
    align-self: flex-start;
}

.search-bar {
    margin-top: 4px;
    height: 34px;
    background-color: rgb(44, 44, 46);
    border-top-left-radius: 17px;
    border-top-right-radius: 17px;
    border-bottom-left-radius: 17px;
    border-bottom-right-radius: 17px;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 10px;
}

.search-bar__placeholder {
    font-size: 18px;
    color: rgb(142, 142, 147);
    margin-left: 4px;
    letter-spacing: 1px;
}

/* ---------- Divider ---------- */
.divider {
    height: 1px;
    background-color: rgb(56, 56, 58);
    flex-shrink: 0;
}

/* ---------- Nav bar ---------- */
.nav-bar {
    flex-direction: row;
    height: 64px;
    background-color: rgb(28, 28, 30);
    border-top-width: 1px;
    border-top-color: rgb(56, 56, 58);
    flex-shrink: 0;
}

.nav-bar__item {
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
    justify-content: center;
}

.nav-bar__label {
    font-size: 11px;
    color: rgb(199, 199, 204);
    -unity-font-style: bold;
    margin-top: 4px;
    letter-spacing: 1px;
}

.nav-bar__profile-circle {
    width: 28px;
    height: 28px;
    background-color: rgb(72, 72, 74);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

/* ---------- Chat card ---------- */
.chat-card {
    flex-direction: row;
    align-items: center;
    padding-top: 10px;
    padding-right: 14px;
    padding-bottom: 10px;
    padding-left: 14px;
    height: 64px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(56, 56, 58);
}

.avatar {
    width: 44px;
    height: 44px;
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
    background-color: rgb(72, 72, 74);
    flex-shrink: 0;
}

.chat-card__center {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    margin-left: 12px;
    min-width: 0;
}

.chat-card__name {
    font-size: 16px;
    color: rgb(245, 245, 247);
    -unity-font-style: bold;
}

.chat-card__subrow {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

.chat-card__status-icon {
    width: 16px;
    height: 10px;
    background-image: url("project://database/Assets/UI/Smartphone/Status_Delivered.png?fileID=2800000&guid=828c6ae5feca411b9fc0723367fe808b&type=3#Status_Delivered");
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
    margin-right: 4px;
}

.chat-card__preview {
    font-size: 13px;
    color: rgb(142, 142, 147);
    flex-shrink: 1;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.chat-card__right {
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
    margin-left: 8px;
}

.chat-card__time {
    font-size: 14px;
    color: rgb(142, 142, 147);
}

/* ---------- Badge ---------- */
.badge {
    width: 22px;
    height: 22px;
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
    background-color: rgb(245, 245, 247);
    align-items: center;
    justify-content: center;
    margin-top: 4px;
}

.badge__text {
    flex-grow: 1;
    align-self: stretch;
    font-size: 16px;
    color: rgb(25, 25, 30);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}
