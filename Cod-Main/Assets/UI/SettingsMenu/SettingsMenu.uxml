<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/MenuStyle.uss?fileID=7433441132597879392&amp;guid=a747a1371a8ed494dbebb750309ee9f3&amp;type=3#MenuStyle" />
    <ui:VisualElement name="background" style="flex-grow: 1; background-color: rgb(0, 0, 0);">
        <ui:Label text="Sound Settings" name="soundSettings" style="-unity-text-align: upper-center; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Fancy-Regular.otf?fileID=12800000&amp;guid=37567676b964d4408b499bb1e061114a&amp;type=3#Fancy-Regular&quot;); -unity-font-style: bold; font-size: 36px;" />
        <ui:Slider label="Master" name="masterVolume" high-value="100" value="100" />
