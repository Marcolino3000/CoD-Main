  m_Script: {fileID: 11500000, guid: 9c0bd1f85e094e118b634ba4dd916b80, type: 3}
  m_Name: Ja Hallo hier is...
  m_EditorClassIdentifier: cod.dialogbuilder::Nodes.Decorator.PlayerDialogOption
  Guid: 5dab6455a7a1a438e8d397caca4b1855
  Position: {x: 766.5, y: 611.5714}
  customPreview: 0
  Blackboard:
    CharacterData: {fileID: 0}
  DialogLine: "Ja Hallo hier ist Mama, also erst einmal hoffe ich, es geht dir gut
    soweit. Ich hoffe, das mit deinem Job ist besser geworden. Ich hab n Schrein
    f\xFCr deinen Job gebaut. \nWir haben uns ja jetzt auch schon mehrere Tage nicht
    gesprochen und ich geh mal davon aus, dass bei dir auch total viel los war und
    bei mir n\xE4mlich jetzt auch es war jetzt in den letzten tagen auch nochmal
    ultra hektisch und stressig. \nIch war viel in der Natur und habe neue Geister
    gesp\xFCrt. Die Energie in diesem Ort ist nicht gut. \nGenau jedenfalls hab ich
    die ganze Zeit ganz intensiv an dich gedacht und war in Gedanken \xE4h bei dir.
    \nAlso eine Sache w\xE4r mir ganz wichtig, dass du den Sauerteig \u2013 ich hab
    dir n Paket geschickt."
  TextPreview: Ja Hallo hier is...
  AudioClip: {fileID: 8300000, guid: f0725d6c0c1ec47f9b5459f5d8aa2802, type: 3}
